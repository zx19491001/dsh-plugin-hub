{
  "name": "@local/dsh-plugin-hub",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "GitHub plugin hub in the DSH sidebar: resolve any repository, pick a branch or tag, download its ZIP, or install it into the profile with one click.",
  "repository": "github:zx19491001/dsh-plugin-hub",
  "homepage": "https://github.com/zx19491001/dsh-plugin-hub",
  "keywords": ["dsh", "plugin", "github", "sidebar", "download"],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/client.test.mjs test/wiring.test.mjs test/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
